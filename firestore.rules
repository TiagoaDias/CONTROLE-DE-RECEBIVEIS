rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if userId scope is valid
    function isValidUserScope(userId) {
      return userId != null && userId.size() > 0;
    }

    // User profile and private subcollections isolated per userId (debtors, purchases, installments, tombstones, auth_records)
    // Allows access for both Firebase Auth sessions and Direct Gmail / Android WebView sessions
    match /users/{userId} {
      allow read, write: if isValidUserScope(userId);

      match /{document=**} {
        allow read, write: if isValidUserScope(userId);
      }
    }

    // Forum topics
    match /forum_topics/{topicId} {
      allow read, write: if true;
    }

    // Registered credentials lookup
    match /registered_credentials/{credId} {
      allow read, write: if true;
    }

    // System connection test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
