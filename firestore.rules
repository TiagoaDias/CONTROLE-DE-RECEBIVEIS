rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify that the authenticated user owns the resource (Strict UID matching)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and private subcollections strictly isolated per UID (debtors, purchases, installments, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Forum topics accessible only to authenticated users
    match /forum_topics/{topicId} {
      allow read, write: if isAuthenticated();
    }
  }
}
