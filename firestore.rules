rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify that the user owns the resource or is master admin
    function isOwner(userId) {
      return !isAuthenticated() ||
             (isAuthenticated() && request.auth.uid == userId) ||
             userId == 'usr_thiago_dias' ||
             (isAuthenticated() && request.auth.token.email == 'tiagodias8888@gmail.com');
    }

    // User profile and private subcollections isolated per UID (debtors, purchases, installments, auth_records)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Forum topics
    match /forum_topics/{topicId} {
      allow read, write: if true;
    }

    // Registered credentials lookup and storage
    match /registered_credentials/{credId} {
      allow read, write: if true;
    }

    // System connection test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
