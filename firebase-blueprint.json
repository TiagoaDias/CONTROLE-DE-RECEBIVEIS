{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with personal and financial preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "phoneWhatsapp": { "type": "string" },
        "authProvider": { "type": "string", "enum": ["local", "gmail", "facebook", "whatsapp"] },
        "avatar": { "type": "string" },
        "companyName": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "role": { "type": "string" },
        "pixKey": { "type": "string" },
        "cep": { "type": "string" },
        "address": { "type": "string" },
        "addressNumber": { "type": "string" },
        "neighborhood": { "type": "string" },
        "cpfCnpj": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isFirstLogin": { "type": "boolean" },
        "hasSeenWelcome": { "type": "boolean" }
      },
      "required": ["id", "name", "email"]
    },
    "Debtor": {
      "title": "Debtor",
      "description": "Debtor record managed by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "notes": { "type": "string" },
        "totalOwed": { "type": "number" },
        "totalPaid": { "type": "number" },
        "overdueCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Original debt/purchase contract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "debtorId": { "type": "string" },
        "product": { "type": "string" },
        "totalAmount": { "type": "number" },
        "installmentsTotal": { "type": "number" },
        "installmentValue": { "type": "number" },
        "firstDueDate": { "type": "string" },
        "nextDueDate": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "debtorId", "product", "totalAmount"]
    },
    "Installment": {
      "title": "Installment",
      "description": "Individual payment installment for a debtor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "debtorId": { "type": "string" },
        "purchaseId": { "type": "string" },
        "installmentNumber": { "type": "number" },
        "totalInstallments": { "type": "number" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string" },
        "paidAt": { "type": "string" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["overdue", "soon", "ontime", "paid"] },
        "notes": { "type": "string" },
        "authCode": { "type": "string" }
      },
      "required": ["id", "userId", "debtorId", "installmentNumber", "amount", "dueDate", "status"]
    },
    "Tombstone": {
      "title": "Tombstone",
      "description": "Permanent deletion marker to prevent deleted items from reappearing",
      "type": "object",
      "properties": {
        "debtorId": { "type": "string" },
        "userId": { "type": "string" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["debtorId", "userId"]
    },
    "ForumTopic": {
      "title": "ForumTopic",
      "description": "Closed discussion topic and feedback for master developer Tiago Dias",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorRole": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["sugestao", "melhoria", "bug", "duvida", "conformidade"] },
        "status": { "type": "string", "enum": ["aberto", "em_analise", "em_desenvolvimento", "concluido", "rejeitado", "aprovado"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "upvotes": { "type": "number" },
        "devResponse": { "type": "string" },
        "devResponseAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorName", "authorEmail", "title", "content", "category", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with PIX, address, and credentials"
    },
    "/users/{userId}/debtors/{debtorId}": {
      "schema": "Debtor",
      "description": "Debtors associated with the user account"
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Purchases and debt contracts associated with the debtor"
    },
    "/users/{userId}/installments/{installmentId}": {
      "schema": "Installment",
      "description": "Payment installments associated with the debtor"
    },
    "/users/{userId}/tombstones/{tombstoneId}": {
      "schema": "Tombstone",
      "description": "Permanent deletion tombstones associated with the user"
    },
    "/forum_topics/{topicId}": {
      "schema": "ForumTopic",
      "description": "Closed community forum topics and feedback suggestions for developer Tiago Dias"
    }
  }
}
